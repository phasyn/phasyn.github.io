{
  "name": "phasyn-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "typegen": "react-router typegen",
    "build": "react-router build && node scripts/finalize-build.ts",
    "preview": "node scripts/serve.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 . && depcruise src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.1",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.4",
    "vitest": "5.1.0"
  }
}
